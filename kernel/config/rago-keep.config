# SPDX-License-Identifier: GPL-2.0
#
# Rago OS — ce que localmodconfig ne doit JAMAIS retirer (module M0).
#
# localmodconfig ne garde que les modules chargés au moment du build. On
# remet ici, en module, les familles dont l'absence casserait la machine plus
# tard : GPU (changement de carte, eGPU), USB (clé, manette, casque branchés
# après le build), réseau (autre carte, Wi-Fi), stockage et hibernation.
# Fusionné après localmodconfig ; vérifié en mode « signalé seulement »
# (un symbole peut dépendre d'une option absente de la config de base).

# --- GPU ---
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_HSA_AMD=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCI=y
CONFIG_SND_USB=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m

# --- USB et périphériques de jeu ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_SONY=m
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_STEAM=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_TYPEC=m
CONFIG_USB4=m

# --- Réseau ---
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_AQTION=m
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_RTL8152=m
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_RTW89=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m

# --- Stockage et systèmes de fichiers (A/B, RAGO-LIB, RAGO-COMM) ---
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_FUSE_FS=m
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m

# --- Hibernation et resume (Fast OS Switch) ---
CONFIG_HIBERNATION=y
CONFIG_SWAP=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
