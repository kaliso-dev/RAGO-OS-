# SPDX-License-Identifier: GPL-2.0
#
# Rago OS — fragment de configuration noyau « gaming » (module M0).
#
# Appliqué par kernel/build_rago_kernel.sh (étape config) au-dessus de la
# config de base (config CachyOS, ou config du noyau courant), après
# localmodconfig et le fragment rago-keep.config, via
# scripts/kconfig/merge_config.sh puis « make olddefconfig ».
#
# Chaque ligne est ensuite VÉRIFIÉE dans le .config final (étape verify) :
# une option demandée ici qui n'a pas « pris » (dépendance manquante,
# symbole absent de la version du noyau, patch CachyOS non appliqué) fait
# échouer le build. « # rago:optional » = seulement signalé.
#
# Le niveau x86-64 (v3 / v4) n'est PAS ici : il est détecté et écrit par le
# script (CONFIG_X86_64_VERSION du patchset CachyOS).

# --- Ordonnancement -----------------------------------------------------------
# Préemption complète : latence d'entrée minimale pour le thread de rendu.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# 1000 Hz : tranches et minuteurs plus fins.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# sched_ext : classe d'ordonnancement BPF qui accueille scx_rago.
CONFIG_SCHED_CLASS_EXT=y
# BORE (patchset CachyOS) : filet de sécurité quand scx_rago n'est pas
# chargé ou est éjecté par le watchdog sched_ext (EEVDF + BORE).
CONFIG_SCHED_BORE=y
# Topologie : ITMT (cœurs préférés Intel / AMD), clusters, multi-cœur.
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_SMT=y
# Classification matérielle des tâches Intel (Thread Director) pour P/E.
CONFIG_INTEL_HFI_THERMAL=y
# Pilote AMD « 3D V-Cache optimizer » (préférence cache / fréquence).
CONFIG_AMD_3D_VCACHE=m

# --- BPF (nécessaire à scx_rago) ------------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# scx_rago (via scx_utils) lit debugfs et la config noyau (externs __kconfig).
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Mémoire ------------------------------------------------------------------
# MGLRU actif par défaut : moins de saccades sous pression mémoire.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# THP : « madvise » par défaut (M1), surchargé par jeu (M14).
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# ZRAM (swap compressé en RAM, M1).
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y

# --- Fréquence CPU ------------------------------------------------------------
CONFIG_X86_AMD_PSTATE=y
# 3 = mode « active » (EPP) par défaut.
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y

# --- Compilation --------------------------------------------------------------
# Clang ThinLTO (le script compile avec LLVM=1).
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# --- Hibernation (Fast OS Switch, M6 / M8) --------------------------------------
CONFIG_HIBERNATION=y
CONFIG_HIBERNATION_COMP_LZ4=y
CONFIG_HIBERNATION_DEF_COMP="lz4"
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# --- Secure Boot, signature, chiffrement -------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y
# Modules signés avec la clé MOK (le script écrit CONFIG_MODULE_SIG_KEY).
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# Non forcé : un module DKMS (pilote NVIDIA) doit être signé avec la clé MOK
# (voir kernel/patches/README.md), mais un oubli ne doit pas empêcher le boot.
# CONFIG_MODULE_SIG_FORCE is not set
# Lockdown non imposé : le mode « integrity » interdit l'hibernation, dont le
# Fast OS Switch (M6) a besoin. Le LSM reste compilé.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY is not set
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
# TPM 2.0 (déverrouillage LUKS, M3) et dm-crypt.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
# Les mitigations restent compilées ; « mitigations=off » est une option de
# démarrage exposée (RAGO_MITIGATIONS dans /etc/rago/kernel.conf).
CONFIG_CPU_MITIGATIONS=y

# --- Jeu -------------------------------------------------------------------------
# Primitives de synchronisation NT pour Wine / Proton (/dev/ntsync).
CONFIG_NTSYNC=m
CONFIG_FUTEX=y
CONFIG_USER_NS=y
CONFIG_UHID=m
CONFIG_HIDRAW=y
